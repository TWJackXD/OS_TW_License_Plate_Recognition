# 預設: 使用 OpenRouter 的小型 Gemma (可能會在高峰時期 429)
VLM_BACKEND=openrouter
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=google/gemma-3-4b-it
OPENROUTER_API_KEY=
VLM_HTTP_RETRIES=3
VLM_MAX_SIDE=384
VLM_JPEG_QUALITY=70

# 主模型 429 時切換到 Flash-Lite; 保持使用 N 秒後再切回主模型
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_SECONDS=10
# OPENROUTER_BYOK=1 # 使用 BYOK 模式
# OPENROUTER_PROVIDER_ORDER=Google

# 可選: 使用 Google AI Studio 而不是 OpenRouter
# VLM_BACKEND=google
# GEMINI_API_KEY=
# VLM_MODEL=gemini-2.5-flash-lite

# 網頁服務
HOST=0.0.0.0
PORT=8010

# 可選車證／罰單模組（modules/permit；啟用後掛載 /api/permits 與 /permit/）
ENABLE_PERMIT_MODULE=1

# 可選 Niimbot B1 即時列印（Web Bluetooth；Chrome/Edge + HTTPS 或 localhost）
ENABLE_NIIMBOT_MODULE=1
# gap=有間隙／黑標紙（預設）；continuous=連續紙
NIIMBOT_LABEL_TYPE=gap
# 列印濃度 1–5
NIIMBOT_DENSITY=3

# 校區舉發範圍（Nominatim 依 OSM id 取多邊形）
# 第一 / 建工 / 楠梓 / 燕巢 / 旗津 / 東方
CAMPUS_OSM_IDS=relation/7242146,relation/7961309,relation/6842066,relation/7267075,relation/7961310,way/237921751
CAMPUS_ENFORCE=1
LANDMARK_SEARCH_RADIUS_M=180
# NOMINATIM_LOOKUP_URL=https://nominatim.openstreetmap.org/lookup
# CAMPUS_BUILDINGS_GEOJSON=data/campus_buildings.geojson
