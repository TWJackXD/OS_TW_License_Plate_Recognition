# 預設: 使用 OpenRouter 的小型 Gemma (可能會在高峰時期 429)
VLM_BACKEND=openrouter
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=google/gemma-3-4b-it
OPENROUTER_API_KEY= # 填入 OpenRouter API Key
VLM_HTTP_RETRIES=3
VLM_MAX_SIDE=384
VLM_JPEG_QUALITY=70

# 主模型 429 時切換到 Flash-Lite; 保持使用 N 秒後再切回主模型
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_SECONDS=10
# OPENROUTER_BYOK=1 # 使用 BYOK 模式
# OPENROUTER_PROVIDER_ORDER=Google

# 可選: 使用 Google AI Studio 而不是 OpenRouter
# VLM_BACKEND=google
# GEMINI_API_KEY= # 填入 Google AI Studio API Key
# VLM_MODEL=gemini-2.5-flash-lite

# 網頁服務
HOST=0.0.0.0
PORT=8010